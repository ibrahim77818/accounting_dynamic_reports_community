<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ks_dfr_res_config_settings_view_form_inherited" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.accounting.dynamic.reports</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='default_taxes_setting_container']" position="after">
                <block title="Dynamic Financial Reports" name="ks_dfr_settings">
                    <setting id="ks_enable_ledger_in_bal_settings"
                             help="Show the initial balance in the General and Partner Ledger.">
                        <field name="ks_enable_ledger_in_bal"/>
                    </setting>
                    <setting id="ks_disable_trial_en_bal_settings"
                             help="Move the initial balance of income/expense accounts to Current Year Earnings in the Trial Balance.">
                        <field name="ks_disable_trial_en_bal"/>
                    </setting>
                    <setting id="ks_disable_bs_sign_settings"
                             help="Show Assets and Liabilities without a negative sign on the Balance Sheet.">
                        <field name="ks_disable_bs_sign"/>
                    </setting>
                    <setting id="ks_enable_net_tax_settings" help="Show the net tax line on the Tax Report.">
                        <field name="ks_enable_net_tax"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
