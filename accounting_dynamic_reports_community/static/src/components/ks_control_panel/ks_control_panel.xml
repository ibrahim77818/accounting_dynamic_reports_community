<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="accounting_dynamic_reports_community.ks_control_panel" owl="1">
        <div class="dfr-control-pannel">
            <ControlPanel display="{'top-right': false}">
                <t t-set-slot="control-panel-bottom-left">
                    <KsReportFilters action="props.action" ks_df_report_opt="props.ks_df_report_opt"
                                     ks_df_informations="props.ks_df_informations"
                                     new_ks_df_reports_ids="props.new_ks_df_reports_ids"
                                     ks_df_context="props.ks_df_context" _ksRenderBody.bind="props._ksRenderBody"
                                     setReportValues.bind="props.setReportValues"
                                     ks_master_value="props.ks_master_value"
                                     ksSetReportInfo.bind="props.ksSetReportInfo"
                                     date_from_cmp="props.date_from_cmp" date_to_cmp="props.date_to_cmp"/>
                </t>
                <t t-set-slot="control-panel-bottom-right">
                    <div class="btn-group ks_dfr_actions" role="group">
                        <button type="button" class="btn btn-primary" t-on-click="OnPrintPdf" title="Print PDF">
                            <i class="fa fa-file-pdf-o me-1"/>PDF
                        </button>
                        <button type="button" class="btn btn-secondary" t-on-click="ksPrintReportXlsx" title="Export to Excel">
                            <i class="fa fa-file-excel-o me-1"/>Excel
                        </button>
                        <button type="button" class="btn btn-secondary" t-on-click="ksReportSendEmail" title="Send the PDF to my e-mail">
                            <i class="fa fa-envelope-o"/>
                        </button>
                    </div>
                </t>
            </ControlPanel>
        </div>
    </t>
</templates>
