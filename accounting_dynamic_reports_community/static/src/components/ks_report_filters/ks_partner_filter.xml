<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ks_searchview_partner_filter" owl="1">
        <Dropdown t-if="props.ks_df_informations['ks_partner']">
<button type="button" t-att-class="'btn btn-secondary ks_filter_btn dropdown-toggle'">
                <i class="fa fa-users me-1"/>Partners:
                <t t-esc="(props.ks_df_informations['ks_selected_partner_name'] || []).join(', ') || 'All'"/>
            </button>
<t t-set-slot="content">
            <div class="px-3 py-2 ks_selector_box">
                <KsRecordSelector t-props="getMultiRecordSelectorProps('res.partner', 'partner_ids')"/>
            </div>
        </t></Dropdown>
    </t>
</templates>