<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ks_searchview_analytic_filter" owl="1">
        <Dropdown>
<button type="button" t-att-class="'btn btn-secondary ks_filter_btn dropdown-toggle'">
                <i class="fa fa-folder-open me-1"/>Analytic:
                <t t-esc="(props.ks_df_informations['selected_analytic_account_names'] || []).join(', ') || 'All'"/>
            </button>
<t t-set-slot="content">
            <div class="px-3 py-2 ks_selector_box">
                <KsRecordSelector t-props="getMultiRecordSelectoraccount('account.analytic.account', 'analytic_accounts')"/>
            </div>
        </t></Dropdown>
    </t>
</templates>