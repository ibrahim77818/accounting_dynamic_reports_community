        <KsControlPanel action="props.action" ks_df_report_opt="ks_df_report_opt" ks_df_informations="props.ks_master_value.ks_df_informations"
                        new_ks_df_reports_ids="props.ks_master_value.new_ks_df_reports_ids" ks_df_context="ks_df_context" _ksRenderBody.bind="_ksRenderBody"
